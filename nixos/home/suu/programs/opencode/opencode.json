{
  "$schema": "https://opencode.ai/config.json",

  "autoupdate": false,

  "mcp": {
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/oauth"
    },

    "nix": {
      "enabled": true,
      "type": "local",
      "command": []
    }
  },

  "permission": {
    "*": "allow",

    "external_directory": {
      "/tmp/**": "allow",
      "/nix/store/**": "allow"
    },

    "bash": {
      "sudo *": "ask"
    },

    "edit": {
      "/nix/store/**": "deny"
    }
  },

  "provider": {
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4-flash": {
          "options": {
            "provider": {
              "order": ["baidu/fp8", "alibaba"],
              "allow_fallbacks": true
            }
          }
        }
      }
    },

    "rightcode_openai": {
      "npm": "@ai-sdk/openai",
      "name": "RC·OpenAI",

      "options": {
        "setCacheKey": true,
        "baseURL": "https://right.codes/codex/v1"
      },

      "models": {
        "gpt-5.5": {
          "id": "gpt-5.5",
          "name": "GPT-5.5",
          "family": "gpt",
          "release_date": "2026-04-23",

          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": false,

          "cost": {
            "input": 2,
            "output": 12,
            "cache_write": 0,
            "cache_read": 0.2
          },

          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          },

          "options": {
            "store": false,
            "promptCacheKey": "opencode-stable-user",
            "include": ["reasoning.encrypted_content"],

            "textVerbosity": "medium",
            "reasoningEffort": "high",
            "reasoningSummary": "auto"
          },

          "variants": {
            "xhigh": {
              "textVerbosity": "medium",
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto"
            },
            "high": {
              "textVerbosity": "medium",
              "reasoningEffort": "high",
              "reasoningSummary": "auto"
            },
            "medium": {
              "textVerbosity": "medium",
              "reasoningEffort": "medium",
              "reasoningSummary": "auto"
            },
            "low": {
              "textVerbosity": "medium",
              "reasoningEffort": "low",
              "reasoningSummary": "auto"
            }
          },

          "headers": {
            "session_id": "opencode-stable-user",
            "x-session-id": "opencode-stable-user",
            "conversation_id": "opencode-stable-user"
          }
        }
      }
    },

    "rightcode_anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "RC·Anthropic",

      "options": {
        "baseURL": "https://right.codes/claude-aws/v1"
      },

      "models": {
        "claude-opus-4-6": {
          "id": "claude-opus-4-6",
          "name": "Claude Opus 4.6",
          "family": "claude-opus",
          "release_date": "2026-02-05",

          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,

          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          },

          "cost": {
            "input": 1.5,
            "output": 7.5,
            "cache_write": 1.875,
            "cache_read": 0.15
          },

          "limit": {
            "context": 1000000,
            "output": 128000
          },

          "options": {}
        }
      }
    }
  }
}
